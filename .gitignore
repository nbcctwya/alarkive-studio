# Local footage, drafts, production projects and library scan results.
# Match B-roll directory casing on case-sensitive systems too.
/[Bb]-[Rr][Oo][Ll][Ll]/
/projects/
/drafts/
/assets/broll_index.json
output/
selected_broll/

# Generated assets and old design experiments; keep the design notes.
/assets/generated/*
/assets/old_design/*
!/assets/old_design/TEXTURE_VARIANTS.md

# Preview output is local. Keep helper code and its maintained inputs.
/preview/**
!/preview/**/
!/preview/**/*.py
!/preview/**/.gitignore
!/preview/bilingual_checks/zh_baseline.json
!/preview/voice_audition_en_20261020/text.txt

